# Copy this file to .env and fill in real values before deploying.
# docker-compose reads this automatically.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=lims.yourlab.example,localhost
DJANGO_TIME_ZONE=Asia/Bangkok

POSTGRES_PASSWORD=change-me-to-a-strong-password

# Set to 1 on first boot only, to load demo fuel types/tests/samples.
# Set back to 0 (or remove) after that — do not leave on in production.
SEED_DEMO_DATA=0

WEB_PORT=8000
