# Copy this file to .env and fill in real values before deploying.
# docker-compose reads this automatically.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=lims.yourlab.example,localhost
DJANGO_TIME_ZONE=Asia/Bangkok

POSTGRES_PASSWORD=change-me-to-a-strong-password

# Email — sends a notification to SAMPLE_NOTIFICATION_EMAIL whenever a new
# sample is registered. Leave EMAIL_HOST blank to disable real delivery
# (mail is just logged instead). Example values below are for Gmail SMTP
# with an app password; swap in your own provider's settings.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=Dynamic LabSystems <no-reply@dynamiclabsystems.example>
SAMPLE_NOTIFICATION_EMAIL=info@dynamicapac.com

# Set to 1 on first boot only, to load demo fuel types/tests/samples.
# Set back to 0 (or remove) after that — do not leave on in production.
SEED_DEMO_DATA=0

WEB_PORT=8000
